//=============================================================================
// ACTION EXECUTION (building)
//=============================================================================

void AAITeamController::ExecuteBuildVehicles()
{
    ACityActor* BuildCity = FindBestCityToBuildAt();
    if (!BuildCity) return;
    
    int32 Cost = ActionConfigs[EAIAction::BuildVehicles].Cost;
    if (Money < Cost) return;
    
    // Spawn vehicle
    FVector CityLocation = BuildCity->GetActorLocation();
    FVector CityDirection = (CityLocation - BuildCity->PlanetCenter).GetSafeNormal();
    
    FVector RandomTangent1 = FVector::CrossProduct(CityDirection, FVector::UpVector).GetSafeNormal();
    if (RandomTangent1.IsNearlyZero())
    {
        RandomTangent1 = FVector::CrossProduct(CityDirection, FVector::RightVector).GetSafeNormal();
    }
    FVector RandomTangent2 = FVector::CrossProduct(CityDirection, RandomTangent1).GetSafeNormal();
    
    float RandomAngle = FMath::FRandRange(0.0f, 2.0f * PI);
    float TurretRadius = BuildCity->CalculateTurretRadius();
    float SpawnDistance = TurretRadius + FMath::FRandRange(1000.0f, 1500.0f);
    
    FVector Offset = (RandomTangent1 * FMath::Cos(RandomAngle) + RandomTangent2 * FMath::Sin(RandomAngle)) * SpawnDistance;
    FVector SpawnDirection = (CityDirection * BuildCity->PlanetRadius + Offset).GetSafeNormal();
    FVector SpawnLocation = BuildCity->PlanetCenter + SpawnDirection * BuildCity->PlanetRadius;
    
    FActorSpawnParameters SpawnParams;
    SpawnParams.Owner = BuildCity;
    
    AVehicleActor* NewVehicle = GetWorld()->SpawnActor<AVehicleActor>(
        AVehicleActor::StaticClass(), SpawnLocation, FRotator::ZeroRotator, SpawnParams);
    
    if (NewVehicle)
    {
        NewVehicle->PlanetCenter = BuildCity->PlanetCenter;
        NewVehicle->PlanetRadius = BuildCity->PlanetRadius;
        NewVehicle->OwnerTeam = ControlledTeam;
        NewVehicle->AlignToPlanet();
        NewVehicle->UpdateColor();
        
        Money -= Cost;
    }
}

void AAITeamController::ExecuteBuildTurrets()
{
    int32 Cost = ActionConfigs[EAIAction::BuildTurrets].Cost;
    if (Money < Cost) return;
    
    // Build at most threatened city
    TArray<ACityActor*> Cities = GetTeamCities();
    Cities.Sort([this](const ACityActor& A, const ACityActor& B)
    {
        float ThreatA = CityDefenseTracking.Contains(&A) ? CityDefenseTracking[&A].ThreatLevel : 0.0f;
        float ThreatB = CityDefenseTracking.Contains(&B) ? CityDefenseTracking[&B].ThreatLevel : 0.0f;
        return ThreatA > ThreatB;
    });
    
    for (ACityActor* City : Cities)
    {
        if (City)
        {
            ATurretBuildingActor* NewTurret = City->AddTurret();
            if (NewTurret)
            {
                Money -= Cost;
                return;
            }
        }
    }
}

void AAITeamController::ExecuteBuildFactories()
{
    int32 Cost = ActionConfigs[EAIAction::BuildFactories].Cost;
    if (Money < Cost) return;
    
    // Build at safest city (highest health)
    TArray<ACityActor*> Cities = GetTeamCities();
    Cities.Sort([](const ACityActor& A, const ACityActor& B)
    {
        return (A.CurrentHealth / A.MaxHealth) > (B.CurrentHealth / B.MaxHealth);
    });
    
    for (ACityActor* City : Cities)
    {
        if (City)
        {
            AFactoryBuildingActor* NewFactory = City->AddFactory();
            if (NewFactory)
            {
                Money -= Cost;
                return;
            }
        }
    }
}

