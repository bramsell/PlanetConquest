FCityAssessment AAITeamController::FindBestAttackTarget()
{
    FCityAssessment Best;
    Best.City = nullptr;
    Best.ConfidenceRatio = 0.0f;
    float BestScore = -FLT_MAX;
    
    TArray<AActor*> AllCities;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), ACityActor::StaticClass(), AllCities);
    
    for (AActor* Actor : AllCities)
    {
        ACityActor* City = Cast<ACityActor>(Actor);
        if (!City || City->OwnerTeam == ControlledTeam || City->OwnerTeam == EOwnerTeam::Neutral)
        {
            continue;
        }
        
        FCityAssessment Assessment = AssessEnemyCity(City);
        
        // Score = confidence (can we win?) + strategic value (is it worth it?)
        float Score = (Assessment.ConfidenceRatio * 0.6f) + (Assessment.StrategicValue * 0.4f);
        
        if (Score > BestScore)
        {
            BestScore = Score;
            Best = Assessment;
        }
    }
    
    return Best;
}

FCityAssessment AAITeamController::AssessEnemyCity(ACityActor* City)
{
    FCityAssessment Assessment;
    Assessment.City = City;
    
    if (!City)
    {
        Assessment.EffectiveStrength = 0.0f;
        Assessment.VehiclesNeeded = 1;
        Assessment.ConfidenceRatio = 10.0f;
        Assessment.StrategicValue = 0.0f;
        return Assessment;
    }
    
    // Calculate effective strength
    float CityHP = City->CurrentHealth;
    int32 TurretCount = City->GetTurretCount();
    float TurretHP = TurretCount * 200.0f;
    float TurretDamage = TurretCount * 200.0f;  // Damage they'll deal during attack
    
    // Count nearby defenders
    int32 Defenders = 0;
    TArray<AActor*> AllVehicles;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AVehicleActor::StaticClass(), AllVehicles);
    
    for (AActor* Actor : AllVehicles)
    {
        AVehicleActor* Vehicle = Cast<AVehicleActor>(Actor);
        if (Vehicle && Vehicle->OwnerTeam == City->OwnerTeam)
        {
            float Distance = FVector::Dist(Vehicle->GetActorLocation(), City->GetActorLocation());
            if (Distance < 2000.0f)
            {
                Defenders++;
            }
        }
    }
    float DefenderThreat = Defenders * 100.0f;
    
    Assessment.EffectiveStrength = CityHP + TurretHP + TurretDamage + DefenderThreat;
    
    // Calculate vehicles needed (each vehicle does ~150 effective damage)
    Assessment.VehiclesNeeded = FMath::Max(3, FMath::CeilToInt(Assessment.EffectiveStrength / 150.0f));
    
    // Confidence ratio
    Assessment.ConfidenceRatio = (float)Pressures.VehiclesOwned / (float)Assessment.VehiclesNeeded;
    
    // Strategic value (weakness + nearby resources)
    float WeaknessFactor = FMath::Clamp(1.0f - (Assessment.EffectiveStrength / 3000.0f), 0.2f, 1.0f);
    
    int32 NearbyResources = 0;
    TArray<AActor*> AllResources;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AResourceActor::StaticClass(), AllResources);
    for (AActor* Actor : AllResources)
    {
        AResourceActor* Resource = Cast<AResourceActor>(Actor);
        if (Resource)
        {
            float Distance = FVector::Dist(Resource->GetActorLocation(), City->GetActorLocation());
            if (Distance < 3000.0f)
            {
                NearbyResources++;
            }
        }
    }
    float ResourceFactor = 0.5f + FMath::Min(0.5f, NearbyResources * 0.1f);
    
    Assessment.StrategicValue = WeaknessFactor * ResourceFactor;
    
    return Assessment;
}

ACityActor* AAITeamController::FindBestCityToBuildAt()
{
    TArray<ACityActor*> Cities = GetTeamCities();
    if (Cities.Num() == 0) return nullptr;
    if (Cities.Num() == 1) return Cities[0];
    
    // Score by threat level (build where needed)
    ACityActor* Best = nullptr;
    float BestScore = -FLT_MAX;
    
    for (ACityActor* City : Cities)
    {
        if (!City) continue;
        
        float Score = 0.0f;
        FVector CityLocation = City->GetActorLocation();
        
        // Count nearby threats
        TArray<AActor*> AllVehicles;
        UGameplayStatics::GetAllActorsOfClass(GetWorld(), AVehicleActor::StaticClass(), AllVehicles);
        
        for (AActor* Actor : AllVehicles)
        {
            AVehicleActor* Vehicle = Cast<AVehicleActor>(Actor);
            if (Vehicle && Vehicle->OwnerTeam != ControlledTeam)
            {
                float Distance = FVector::Dist(CityLocation, Vehicle->GetActorLocation());
                if (Distance < 3000.0f)
                {
                    Score += 10.0f;
                }
            }
        }
        
        // Frontline bonus
        TArray<AActor*> AllCities;
        UGameplayStatics::GetAllActorsOfClass(GetWorld(), ACityActor::StaticClass(), AllCities);
        
        for (AActor* Actor : AllCities)
        {
            ACityActor* OtherCity = Cast<ACityActor>(Actor);
            if (OtherCity && OtherCity->OwnerTeam != ControlledTeam && OtherCity->OwnerTeam != EOwnerTeam::Neutral)
            {
                float Distance = FVector::Dist(CityLocation, OtherCity->GetActorLocation());
                if (Distance < 5000.0f)
                {
                    Score += 5.0f;
                }
            }
        }
        
        if (Score > BestScore)
        {
            BestScore = Score;
            Best = City;
        }
    }
    
    return Best ? Best : Cities[0];
}

AResourceActor* AAITeamController::FindBestResourceToCapture(FVector VehicleLocation)
{
    TArray<AActor*> AllResources;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AResourceActor::StaticClass(), AllResources);
    
    TArray<ACityActor*> OurCities = GetTeamCities();
    TArray<AVehicleActor*> OurVehicles = GetTeamVehicles();
    
    if (OurCities.Num() == 0) return nullptr;
    
    // Get enemy cities for proximity check
    TArray<AActor*> AllCitiesActors;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), ACityActor::StaticClass(), AllCitiesActors);
    TArray<ACityActor*> EnemyCities;
    for (AActor* Actor : AllCitiesActors)
    {
        ACityActor* City = Cast<ACityActor>(Actor);
        if (City && City->OwnerTeam != ControlledTeam && City->OwnerTeam != EOwnerTeam::Neutral)
        {
            EnemyCities.Add(City);
        }
    }
    
    AResourceActor* Best = nullptr;
    float BestDistance = FLT_MAX;
    
    for (AActor* Actor : AllResources)
    {
        AResourceActor* Resource = Cast<AResourceActor>(Actor);
        if (!Resource || Resource->OwnerTeam == ControlledTeam) continue;
        if (Resource->OwnerTeam != EOwnerTeam::Neutral) continue;  // Only neutral resources
        
        // Check if already targeted
        bool bTargeted = false;
        for (AVehicleActor* V : OurVehicles)
        {
            if (V->TargetResource == Resource)
            {
                bTargeted = true;
                break;
            }
        }
        if (bTargeted) continue;
        
        FVector ResourceLocation = Resource->GetActorLocation();
        
        // Must be proximal (closer to us than enemy)
        float NearestOurCity = FLT_MAX;
        for (ACityActor* City : OurCities)
        {
            NearestOurCity = FMath::Min(NearestOurCity, FVector::Dist(City->GetActorLocation(), ResourceLocation));
        }
        
        float NearestEnemyCity = FLT_MAX;
        for (ACityActor* City : EnemyCities)
        {
            NearestEnemyCity = FMath::Min(NearestEnemyCity, FVector::Dist(City->GetActorLocation(), ResourceLocation));
        }
        
        if (NearestOurCity >= NearestEnemyCity) continue;  // Not proximal
        
        // Pick closest to vehicle
        float Distance = FVector::Dist(VehicleLocation, ResourceLocation);
        if (Distance < BestDistance)
        {
            BestDistance = Distance;
            Best = Resource;
        }
    }
    
    return Best;
}

AResourceActor* AAITeamController::FindBestEnemyResourceToCapture(FVector VehicleLocation)
{
    TArray<AActor*> AllResources;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AResourceActor::StaticClass(), AllResources);
    
    TArray<ACityActor*> OurCities = GetTeamCities();
    TArray<AVehicleActor*> OurVehicles = GetTeamVehicles();
    
    if (OurCities.Num() == 0) return nullptr;
    
    AResourceActor* Best = nullptr;
    float BestScore = FLT_MAX;
    
    for (AActor* Actor : AllResources)
    {
        AResourceActor* Resource = Cast<AResourceActor>(Actor);
        if (!Resource || Resource->OwnerTeam == ControlledTeam) continue;
        if (Resource->OwnerTeam == EOwnerTeam::Neutral) continue;  // Only enemy resources
        
        // Check if already targeted
        bool bTargeted = false;
        for (AVehicleActor* V : OurVehicles)
        {
            if (V->TargetResource == Resource)
            {
                bTargeted = true;
                break;
            }
        }
        if (bTargeted) continue;
        
        FVector ResourceLocation = Resource->GetActorLocation();
        
        // Score by distance to vehicle + distance to nearest city
        float NearestCityDist = FLT_MAX;
        for (ACityActor* City : OurCities)
        {
            NearestCityDist = FMath::Min(NearestCityDist, FVector::Dist(City->GetActorLocation(), ResourceLocation));
        }
        
        float VehicleDist = FVector::Dist(VehicleLocation, ResourceLocation);
        float Score = (NearestCityDist * 0.4f) + (VehicleDist * 0.6f);
        
        if (Score < BestScore)
        {
            BestScore = Score;
            Best = Resource;
        }
    }
    
    return Best;
}

AVehicleActor* AAITeamController::FindBestEnemyVehicle(FVector FromLocation)
{
    TArray<AActor*> AllVehicles;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AVehicleActor::StaticClass(), AllVehicles);
    
    AVehicleActor* Best = nullptr;
    float BestScore = FLT_MAX;
    
    for (AActor* Actor : AllVehicles)
    {
        AVehicleActor* Vehicle = Cast<AVehicleActor>(Actor);
        if (!Vehicle || Vehicle->OwnerTeam == ControlledTeam) continue;
        
        float Distance = FVector::Dist(FromLocation, Vehicle->GetActorLocation());
        float HealthFactor = Vehicle->CurrentHealth / Vehicle->MaxHealth;
        
        float Score = Distance * (0.5f + HealthFactor * 0.5f);  // Prefer closer + weaker
        
        if (Score < BestScore)
        {
            BestScore = Score;
            Best = Vehicle;
        }
    }
    
    return Best;
}

AVehicleActor* AAITeamController::FindBestEnemyNearCity(ACityActor* City, FVector FromLocation)
{
    if (!City) return nullptr;
    
    TArray<AActor*> AllVehicles;
    UGameplayStatics::GetAllActorsOfClass(GetWorld(), AVehicleActor::StaticClass(), AllVehicles);
    
    AVehicleActor* Best = nullptr;
    float BestScore = FLT_MAX;
    
    for (AActor* Actor : AllVehicles)
    {
        AVehicleActor* Vehicle = Cast<AVehicleActor>(Actor);
        if (!Vehicle || Vehicle->OwnerTeam == ControlledTeam) continue;
        
        float DistToCity = FVector::Dist(City->GetActorLocation(), Vehicle->GetActorLocation());
        float DistToDefender = FVector::Dist(FromLocation, Vehicle->GetActorLocation());
        
        float Score = (DistToCity * 0.7f) + (DistToDefender * 0.3f);
        Score *= (0.5f + (Vehicle->CurrentHealth / Vehicle->MaxHealth) * 0.5f);
        
        if (Score < BestScore)
        {
            BestScore = Score;
            Best = Vehicle;
        }
    }
    
    return Best;
}

FVector AAITeamController::GetDefensePosition(ACityActor* CityToDefend, int32 DefenderIndex)
{
    if (!CityToDefend) return FVector::ZeroVector;
    
    FVector CityLocation = CityToDefend->GetActorLocation();
    FVector CityDirection = (CityLocation - CityToDefend->PlanetCenter).GetSafeNormal();
    
    FVector Tangent1 = FVector::CrossProduct(CityDirection, FVector::UpVector).GetSafeNormal();
    if (Tangent1.IsNearlyZero())
    {
        Tangent1 = FVector::CrossProduct(CityDirection, FVector::RightVector).GetSafeNormal();
    }
    FVector Tangent2 = FVector::CrossProduct(CityDirection, Tangent1).GetSafeNormal();
    
    float Angle = DefenderIndex * (2.0f * PI / 8.0f);
    float Radius = 800.0f;
    
    FVector Offset = (Tangent1 * FMath::Cos(Angle) + Tangent2 * FMath::Sin(Angle)) * Radius;
    FVector DefenseDirection = (CityDirection * CityToDefend->PlanetRadius + Offset).GetSafeNormal();
    
    return CityToDefend->PlanetCenter + DefenseDirection * CityToDefend->PlanetRadius;
}

