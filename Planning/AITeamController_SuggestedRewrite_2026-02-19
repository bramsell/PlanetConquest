    UE_LOG(LogTemp, Warning, TEXT("  Military: %d vehicles | %d cities"),
        Pressures.VehiclesOwned, Pressures.CitiesOwned);
    UE_LOG(LogTemp, Warning, TEXT("  Threats: %d cities under attack | %d proximal enemies | %.0f total threat"),
        Pressures.CitiesUnderAttack, Pressures.ProximalEnemyVehicles, Pressures.TotalThreatLevel);
    
    // Goals
    UE_LOG(LogTemp, Warning, TEXT("GOALS:"));
    for (auto& Pair : GoalWeights)
    {
        UE_LOG(LogTemp, Warning, TEXT("  %s: %.1f%%"), *GoalToString(Pair.Key), Pair.Value * 100.0f);
    }
    
    // Actions
    UE_LOG(LogTemp, Warning, TEXT("ACTIONS (sorted by score):"));
    for (EAIAction Action : SortedActions)
    {
        FActionConfig& Config = ActionConfigs[Action];
        UE_LOG(LogTemp, Warning, TEXT("  %s: Score=%.3f | %s | Allocated: %d vehicles, $%d"),
            *ActionToString(Action), ActionScores[Action],
            Config.bCanExecute ? TEXT("EXECUTE") : TEXT("skip"),
            Config.AllocatedVehicles, Config.AllocatedMoney);
    }
    
    // Best target
    if (CachedBestTarget.City)
    {
        UE_LOG(LogTemp, Warning, TEXT("BEST TARGET: %s (strength %.0f, need %d vehicles, confidence %.2fx)"),
            *CachedBestTarget.City->GetName(), CachedBestTarget.EffectiveStrength,
            CachedBestTarget.VehiclesNeeded, CachedBestTarget.ConfidenceRatio);
    }
    
    UE_LOG(LogTemp, Warning, TEXT("==========================================\n"));
}

FString AAITeamController::GoalToString(EStrategicGoal Goal)
{
    switch (Goal)
    {
    case EStrategicGoal::ConquerEnemy: return TEXT("ConquerEnemy");
    case EStrategicGoal::DefendTerritory: return TEXT("DefendTerritory");
    case EStrategicGoal::EconomicGrowth: return TEXT("EconomicGrowth");
    case EStrategicGoal::MilitaryBuildup: return TEXT("MilitaryBuildup");
    default: return TEXT("Unknown");
    }
}

FString AAITeamController::ActionToString(EAIAction Action)
{
    switch (Action)
    {
    case EAIAction::CaptureResources: return TEXT("CaptureResources");
    case EAIAction::CaptureEnemyResources: return TEXT("CaptureEnemyResources");
    case EAIAction::CaptureCities: return TEXT("CaptureCities");
    case EAIAction::AttackVehicles: return TEXT("AttackVehicles");
    case EAIAction::DefendCities: return TEXT("DefendCities");
    case EAIAction::BuildVehicles: return TEXT("BuildVehicles");
    case EAIAction::BuildTurrets: return TEXT("BuildTurrets");
    case EAIAction::BuildFactories: return TEXT("BuildFactories");
    default: return TEXT("Unknown");
    }
}




